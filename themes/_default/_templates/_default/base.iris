<!DOCTYPE html>
<html
    {% if existsIn(site.data, "language") %}lang="{{site.data.language}}"{% endif %}
>
    <head>
        {% include "partials/head.iris" %}
    </head>
    <body>
        {% include "partials/header.iris" %}
        <div class="flag start-flag"></div>

        <aside id="_default-index">
            <h2>Index</h2>
            {% set subtree = treePages("/") %}
            {# In theory, this should never trigger since every site _will_ have an index, but whatever #}
            {% if subtree.index != null %}
            <p><a href="{{ abspath(subtree.index.url) }}">{{ subtree.index.title }}</a></p>
            {% endif %}
            <ul>
                {% set context = {
                    "currTree": subtree,
                    "page": page,
                    "site": site
                } %}
                {{ recurseInclude("partials/tree_builder.iris", context) }}
            </ul>
        </aside>
        <main>
            {% block content %}
            {% endblock %}
        </main>

        <div class="flag end-flag"></div>
        {% include "partials/footer.iris" %}
    </body>
</html>
