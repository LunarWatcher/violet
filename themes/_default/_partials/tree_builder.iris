{# Direct root descendants #}
{% for page in currTree.items %}
    <li><a href="{{ abspath(page.url) }}">{{ page.title }}</a></li>
{% endfor %}

{% for nextTree in currTree.subfolders %}
    <li>
        {% if nextTree.index != null %}
            <a href="{{ abspath(nextTree.index.url) }}">{{ nextTree.index.title }}</a>
        {% else %}
            {{ nextTree.folder_name }}
        {% endif %}
        <ul>
            {% set context = {
                "currTree": nextTree,
                "page": page,
                "site": site
            } %}
            {{ recurseInclude("partials/tree_builder.iris", context) }}
        </ul>
    </li>
{% endfor %}
