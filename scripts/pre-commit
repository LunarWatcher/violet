#!/usr/bin/bash

echo "Doing clean build"

git_root=$(git rev-parse --show-toplevel)
cd "$git_root"

build() {
    # rm CMakeCache.txt
    # Required for cmake to work for whatever reason from the git hook
    # Fuck you cmake
    unset GIT_DIR GIT_INDEX_FILE GIT_PREFIX GIT_EXEC_PATH GIT_EDITOR GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_AUTHOR_DATE
    if ! cmake .. -DCMAKE_BUILD_TYPE=Debug -DVIOLET_SANITISE=ON -DVIOLET_WARNINGS_ARE_ERRORS=ON -DVIOLET_CLANG_TIDY=ON; then
        echo "Failed to run CMake setup!"
        exit 1
    fi

    if ! cmake --build . -j $(nproc); then
        echo "Failed to run build!"
        exit 1
    fi

    if ! cmake --build . -j $(nproc) -t test; then
        echo "Tests failed!"
        exit 1
    fi
}

mkdir -p build-precommit
cd build-precommit

# TODO: Is this if necessary when the func calls exit?
if ! build; then
    exit 1
fi

