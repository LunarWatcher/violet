# -*- mode: shell[bash] -*-

git_root=$(git rev-parse --show-toplevel)

function help() {
    echo "Commands:"
    echo -e "\tgen-docs\tGenerate violet's doc page (Firefox local mapping-compatible)"
    echo -e "\tgen-docs-local\tGenerate violet's doc page (-l passed to open raw files)"
    echo -e "\tserve\t\tRuns violet serve on the docs"
    echo -e "\tpublish\t\tMAINTAINER ONLY: Publish the docs to codeberg"
    echo -e "\tgenpkg\t\tGenerate a new PKGBUILD. Should only be used while a tag is checked out."
}

function gen-docs() {
    violet_root="$(pwd)"
    if ! make -j $(nproc); then
        echo "Build failed"
        return 1
    fi

    pushd "${git_root}/docs"
    "${violet_root}/bin/violet" generate -d -p /
    popd
}

function gen-docs-local() {
    violet_root="$(pwd)"
    if ! make -j $(nproc); then
        echo "Build failed"
        return 1
    fi

    pushd "${git_root}/docs"
    # Required to support interrupts
    trap popd 0
    "${violet_root}/bin/violet" generate -d -l
}

function serve() {
    violet_root="$(pwd)"
    if ! make -j $(nproc); then
        echo "Build failed"
        return 1
    fi

    pushd "${git_root}/docs"
    "${violet_root}/bin/violet" serve -d
    popd
}

function publish() {
    "${git_root}/scripts/publish.sh"
}

function genpkg() {
    "${git_root}/scripts/pkgbuild-gen.sh"
}
